# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENAI_API_KEY=

# 쿠팡 파트너스
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# Unsplash 스톡 이미지
UNSPLASH_ACCESS_KEY=

# 네이버 (크롤링용 — 선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 네이버 자동 포스팅 (Playwright, 로컬 전용, 선택)
#
# ⚠️  경고:
#   - 자동화 전용 테스트 네이버 계정에서만 사용할 것. 메인 계정 사용 시 계정 정지 위험.
#   - 2단계 인증(2FA)이 설정되지 않은 계정에서만 동작.
#   - ALLOW_NAVER_AUTOMATION=1 은 절대 Vercel·외부 서버에 설정하지 말 것.
#   - 공개 배포·타인 위임 금지.
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_NAVER_AUTOMATION=    # 로컬에서만: 1 로 설정 시 Playwright 자동 포스팅 활성화
NAVER_ID=                  # 테스트 계정 아이디
NAVER_PW=                  # 테스트 계정 비밀번호
